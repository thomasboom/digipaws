<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TextAppearance.Material3.HeadlineMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/blockers"
            android:textStyle="bold" />

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/blockers_description" />

        <!-- View/Reel Blocker Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/view_blocker_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/view_blocker_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="?attr/colorErrorContainer"
                    android:padding="12dp"
                    android:src="@drawable/baseline_play_circle_24"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorOnErrorContainer" />

                <TextView
                    android:id="@+id/view_blocker_title"
                    style="@style/TextAppearance.Material3.TitleLarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/view_reel_blocker"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/view_blocker_chip"
                    app:layout_constraintStart_toEndOf="@id/view_blocker_icon"
                    app:layout_constraintTop_toTopOf="@id/view_blocker_icon" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/view_blocker_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/disabled"
                    app:chipIcon="@drawable/baseline_warning_24"
                    app:chipIconTint="@color/design_default_color_error"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/view_blocker_desc"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:text="@string/view_blocker_desc"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/view_blocker_icon"
                    app:layout_constraintTop_toBottomOf="@id/view_blocker_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_config_viewblocker_warning"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:enabled="false"
                    android:text="@string/manage_warning_screen"
                    app:icon="@drawable/baseline_warning_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/view_blocker_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_config_viewblocker_cheat_hours"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/manage_cheat_hours"
                    app:icon="@drawable/baseline_schedule_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_config_viewblocker_warning" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/help_reel_blocker"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/what_is_this"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_config_viewblocker_cheat_hours" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Keyword Blocker Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/keyword_blocker_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/keyword_blocker_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="?attr/colorTertiaryContainer"
                    android:padding="12dp"
                    android:src="@drawable/baseline_text_fields_24"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorOnTertiaryContainer" />

                <TextView
                    android:id="@+id/keyword_blocker_title"
                    style="@style/TextAppearance.Material3.TitleLarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/keyword_blocker"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/keyword_blocker_chip"
                    app:layout_constraintStart_toEndOf="@id/keyword_blocker_icon"
                    app:layout_constraintTop_toTopOf="@id/keyword_blocker_icon" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/keyword_blocker_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/disabled"
                    app:chipIcon="@drawable/baseline_warning_24"
                    app:chipIconTint="@color/design_default_color_error"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/keyword_blocker_desc"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:text="@string/keyword_blocker_desc"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/keyword_blocker_icon"
                    app:layout_constraintTop_toBottomOf="@id/keyword_blocker_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/select_blocked_keywords"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:enabled="false"
                    android:text="@string/add_custom_keywords"
                    app:icon="@drawable/baseline_add_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/keyword_blocker_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_manage_preinstalled_keywords"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/manage_keyword_packs"
                    app:icon="@drawable/baseline_apps_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/select_blocked_keywords" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_manage_keyword_blocker"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/configure_blocker"
                    app:icon="@drawable/baseline_settings_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_manage_preinstalled_keywords" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
