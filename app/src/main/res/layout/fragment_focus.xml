<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TextAppearance.Material3.HeadlineMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/focus"
            android:textStyle="bold" />

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/focus_description" />

        <!-- App Blocker Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/app_blocker_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/app_blocker_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/baseline_app_shortcut_24"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:padding="12dp"
                    android:src="@drawable/baseline_app_shortcut_24"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/app_blocker_title"
                    style="@style/TextAppearance.Material3.TitleLarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/app_blocker"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/app_blocker_chip"
                    app:layout_constraintStart_toEndOf="@id/app_blocker_icon"
                    app:layout_constraintTop_toTopOf="@id/app_blocker_icon" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/app_blocker_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/disabled"
                    app:chipIcon="@drawable/baseline_warning_24"
                    app:chipIconTint="@color/design_default_color_error"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/app_blocker_desc"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:text="@string/app_blocker_desc"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/app_blocker_icon"
                    app:layout_constraintTop_toBottomOf="@id/app_blocker_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/select_blocked_apps"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:enabled="false"
                    android:text="@string/select_blocked_apps"
                    app:icon="@drawable/baseline_apps_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/app_blocker_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/app_blocker_warning"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/warning_app_blocker_settings"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/select_blocked_apps"
                    tools:visibility="visible" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Focus Mode Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/focus_mode_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/focus_mode_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="?attr/colorSecondaryContainer"
                    android:padding="12dp"
                    android:src="@drawable/baseline_focus_24"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorOnSecondaryContainer" />

                <TextView
                    android:id="@+id/focus_mode_title"
                    style="@style/TextAppearance.Material3.TitleLarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/focus_mode"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/focus_mode_chip"
                    app:layout_constraintStart_toEndOf="@id/focus_mode_icon"
                    app:layout_constraintTop_toTopOf="@id/focus_mode_icon" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/focus_mode_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/disabled"
                    app:chipIcon="@drawable/baseline_warning_24"
                    app:chipIconTint="@color/design_default_color_error"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/focus_mode_desc"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:text="@string/focus_mode_desc"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/focus_mode_icon"
                    app:layout_constraintTop_toBottomOf="@id/focus_mode_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/select_focus_apps"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:enabled="false"
                    android:text="@string/select_apps"
                    app:icon="@drawable/baseline_apps_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/focus_mode_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/start_focus_mode"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/start_focus_mode"
                    app:icon="@drawable/baseline_play_arrow_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/select_focus_apps" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auto_focus"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/setup_auto_focus"
                    app:icon="@drawable/baseline_schedule_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/start_focus_mode" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/focus_mode_warning"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/warning_app_blocker_settings"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/auto_focus"
                    tools:visibility="visible" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Grayscale Filter Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/grayscale_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/grayscale_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="?attr/colorTertiaryContainer"
                    android:padding="12dp"
                    android:src="@drawable/baseline_filter_b_and_w_24"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorOnTertiaryContainer" />

                <TextView
                    android:id="@+id/grayscale_title"
                    style="@style/TextAppearance.Material3.TitleLarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/grayscale_filter"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/grayscale_chip"
                    app:layout_constraintStart_toEndOf="@id/grayscale_icon"
                    app:layout_constraintTop_toTopOf="@id/grayscale_icon" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/grayscale_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/disabled"
                    app:chipIcon="@drawable/baseline_warning_24"
                    app:chipIconTint="@color/design_default_color_error"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/grayscale_desc"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:text="@string/grayscale_desc"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/grayscale_icon"
                    app:layout_constraintTop_toBottomOf="@id/grayscale_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/select_grayscale_apps"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:enabled="false"
                    android:text="@string/select_apps"
                    app:icon="@drawable/baseline_apps_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/grayscale_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/setup_grayscale"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/setup_filter"
                    app:icon="@drawable/baseline_settings_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/select_grayscale_apps" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
